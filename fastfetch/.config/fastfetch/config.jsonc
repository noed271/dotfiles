// Inspired by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/noros/cat.txt",
        "color": {
            "1": "38;2;122;162;247",
        },
        "padding": {
            "top": 4,
            "left": 3,
            "right": 3
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "38;2;192;202;245",
            "title": "38;2;122;162;247"
        }
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#38;2;247;118;142} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#38;2;158;206;106}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {#38;2;224;175;104}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {#38;2;122;162;247}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#38;2;187;154;247} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#38;2;125;207;255}󰇄 desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#38;2;247;118;142} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#38;2;158;206;106} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#38;2;224;175;104}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#38;2;122;162;247}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#38;2;187;154;247} memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {#38;2;125;207;255}󰩟 network {#keys}│",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#38;2;192;202;245} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}